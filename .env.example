# MilestoneProof Environment Configuration Example
# Copy this file to .env and configure your desired settings.
# NEVER commit real API keys or secrets to Git.

# Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development

# Open-Weight AI Model Provider Configuration (Optional)
# If not configured, MilestoneProof automatically runs in Deterministic Engine Mode.

# Example 1: Groq (Free Tier available at https://console.groq.com)
# MODEL_API_BASE=https://api.groq.com/openai/v1
# MODEL_API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.1-8b-instant

# Example 2: Hugging Face Serverless Inference API (Free tier with HF Access Token)
# MODEL_API_BASE=https://api-inference.huggingface.co/v1
# MODEL_API_KEY=your_huggingface_user_access_token_here
# MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct

# Example 3: OpenRouter (Free open-weight models available)
# MODEL_API_BASE=https://openrouter.ai/api/v1
# MODEL_API_KEY=your_openrouter_api_key_here
# MODEL_NAME=meta-llama/llama-3.2-3b-instruct:free

# Example 4: Local or Remote Ollama Instance
# OLLAMA_HOST=http://localhost:11434
# MODEL_NAME=phi3:latest

# Request Timeout in Seconds
MODEL_TIMEOUT=30
